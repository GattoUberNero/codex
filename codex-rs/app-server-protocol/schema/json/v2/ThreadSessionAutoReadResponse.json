{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AgentPath": {
      "type": "string"
    },
    "NeroAutoRuntimeConfig": {
      "properties": {
        "autonomy_level": {
          "format": "int64",
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "max_auto_rounds": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "autonomy_level",
        "enabled",
        "max_auto_rounds"
      ],
      "type": "object"
    },
    "SessionSource": {
      "oneOf": [
        {
          "enum": [
            "cli",
            "vscode",
            "exec",
            "appServer",
            "unknown"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "custom": {
              "type": "string"
            }
          },
          "required": [
            "custom"
          ],
          "title": "CustomSessionSource",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "subAgent": {
              "$ref": "#/definitions/SubAgentSource"
            }
          },
          "required": [
            "subAgent"
          ],
          "title": "SubAgentSessionSource",
          "type": "object"
        }
      ]
    },
    "SubAgentSource": {
      "oneOf": [
        {
          "enum": [
            "review",
            "compact",
            "memory_consolidation"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "thread_spawn": {
              "properties": {
                "agent_nickname": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "agent_path": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/AgentPath"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "agent_role": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "depth": {
                  "format": "int32",
                  "type": "integer"
                },
                "parent_thread_id": {
                  "$ref": "#/definitions/ThreadId"
                }
              },
              "required": [
                "depth",
                "parent_thread_id"
              ],
              "type": "object"
            }
          },
          "required": [
            "thread_spawn"
          ],
          "title": "ThreadSpawnSubAgentSource",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "other": {
              "type": "string"
            }
          },
          "required": [
            "other"
          ],
          "title": "OtherSubAgentSource",
          "type": "object"
        }
      ]
    },
    "ThreadId": {
      "type": "string"
    },
    "ThreadSessionAutoApplied": {
      "properties": {
        "autoRounds": {
          "format": "int64",
          "type": "integer"
        },
        "autonomyLevel": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "autonomyStepPerRound": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "doneStopScope": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "maxAutoRounds": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "autoRounds"
      ],
      "type": "object"
    },
    "ThreadSessionAutoAuthorityMode": {
      "enum": [
        "bridgeProxy"
      ],
      "type": "string"
    },
    "ThreadSessionAutoDefaults": {
      "properties": {
        "autonomyStepPerRound": {
          "format": "double",
          "type": "number"
        },
        "doneStopScope": {
          "type": "string"
        },
        "runtime": {
          "$ref": "#/definitions/NeroAutoRuntimeConfig"
        }
      },
      "required": [
        "autonomyStepPerRound",
        "doneStopScope",
        "runtime"
      ],
      "type": "object"
    },
    "ThreadSessionAutoEffective": {
      "properties": {
        "autoRounds": {
          "format": "int64",
          "type": "integer"
        },
        "autonomyStepPerRound": {
          "format": "double",
          "type": "number"
        },
        "doneStopScope": {
          "type": "string"
        },
        "runtime": {
          "$ref": "#/definitions/NeroAutoRuntimeConfig"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "autoRounds",
        "autonomyStepPerRound",
        "doneStopScope",
        "runtime",
        "source"
      ],
      "type": "object"
    },
    "ThreadSessionAutoState": {
      "properties": {
        "applied": {
          "$ref": "#/definitions/ThreadSessionAutoApplied"
        },
        "configPath": {
          "type": "string"
        },
        "defaults": {
          "$ref": "#/definitions/ThreadSessionAutoDefaults"
        },
        "effective": {
          "$ref": "#/definitions/ThreadSessionAutoEffective"
        },
        "isSubagent": {
          "type": "boolean"
        },
        "loaded": {
          "type": "boolean"
        },
        "sessionSource": {
          "$ref": "#/definitions/SessionSource"
        },
        "statePath": {
          "type": "string"
        },
        "threadName": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "applied",
        "configPath",
        "defaults",
        "effective",
        "isSubagent",
        "loaded",
        "sessionSource",
        "statePath",
        "version"
      ],
      "type": "object"
    }
  },
  "properties": {
    "authority": {
      "$ref": "#/definitions/ThreadSessionAutoAuthorityMode"
    },
    "state": {
      "$ref": "#/definitions/ThreadSessionAutoState"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "authority",
    "state",
    "threadId"
  ],
  "title": "ThreadSessionAutoReadResponse",
  "type": "object"
}